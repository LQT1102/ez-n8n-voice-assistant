# n8n Voice Assistant Environment Variables

# n8n Webhook URL - Endpoint để gửi tin nhắn và nhận phản hồi
VITE_N8N_WEBHOOK_URL=http://localhost:5678/webhook/voice-assistant

# Google Sheet URL - Link Google Sheet để lưu trữ và xem thông tin đã nhập
# Thay YOUR_SHEET_ID bằng ID thực của Google Sheet
VITE_GOOGLE_SHEET_URL=https://docs.google.com/spreadsheets/d/19ah-FdzVsdq6Eh9sQxL631XviuHMvNEozQHDtRw9uDg/edit?usp=sharing